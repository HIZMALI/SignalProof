{
  "name": "signalproof",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4173",
    "build": "tsc -b && vite build",
    "build:pages": "tsc -b && vite build --base=/SignalProof/",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "test:e2e": "npm run build && npm run profile && node scripts/run-e2e.mjs",
    "test:pages": "npm run build:pages && node scripts/run-e2e.mjs --config playwright.pages.config.ts",
    "test:live": "node scripts/run-e2e.mjs --config playwright.live.config.ts",
    "assets:release": "npm run build:pages && node scripts/capture-release-assets.mjs",
    "verify:release-build": "node scripts/verify-release-build.mjs",
    "notices:generate": "node scripts/third-party-notices.mjs",
    "profile": "node scripts/profile.mjs",
    "browsers:install": "node scripts/install-browsers.mjs"
  },
  "dependencies": {
    "@js-temporal/polyfill": "0.5.1",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
